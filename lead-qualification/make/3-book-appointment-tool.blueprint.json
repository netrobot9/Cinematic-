{
  "name": "3 - Book Appointment (Vapi Tool)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "REPLACE_BOOK_APPOINTMENT_WEBHOOK_ID",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": { "designer": { "x": 0, "y": 0 } }
    },
    {
      "id": 2,
      "module": "google-calendar:ActionCreateEvent",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0,
        "calendar": "primary"
      },
      "mapper": {
        "summary": "Discovery call - {{if(1.body.message.toolCallList[1].function.arguments.name; 1.body.message.toolCallList[1].function.arguments.name; \"Lead\")}}",
        "description": "Booked automatically by the AI lead qualification agent.",
        "start": "{{1.body.message.toolCallList[1].function.arguments.start_time}}",
        "end": "{{addMinutes(parseDate(1.body.message.toolCallList[1].function.arguments.start_time; \"YYYY-MM-DDTHH:mm:ss.SSSZ\"); 30)}}"
      },
      "metadata": { "designer": { "x": 300, "y": 0 } }
    },
    {
      "id": 3,
      "module": "airtable:ActionSearchRecords",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0,
        "base": "REPLACE_AIRTABLE_BASE_ID",
        "table": "REPLACE_AIRTABLE_LEADS_TABLE_ID",
        "maxRecords": 1
      },
      "mapper": {
        "filterByFormula": "{Vapi Call ID} = '{{1.body.message.call.id}}'"
      },
      "metadata": { "designer": { "x": 600, "y": 0 } }
    },
    {
      "id": 4,
      "module": "airtable:ActionUpdateRecord",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0,
        "base": "REPLACE_AIRTABLE_BASE_ID",
        "table": "REPLACE_AIRTABLE_LEADS_TABLE_ID"
      },
      "mapper": {
        "recordId": "{{3[1].id}}",
        "Status": "Booked",
        "Appointment Time": "{{1.body.message.toolCallList[1].function.arguments.start_time}}"
      },
      "metadata": { "designer": { "x": 900, "y": 0 } }
    },
    {
      "id": 5,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {
        "status": 200,
        "headers": [
          { "name": "Content-Type", "value": "application/json" }
        ]
      },
      "mapper": {
        "body": "{\"results\":[{\"toolCallId\":\"{{1.body.message.toolCallList[1].id}}\",\"result\":\"Booked. The discovery call is confirmed for {{1.body.message.toolCallList[1].function.arguments.start_time}}.\"}]}"
      },
      "metadata": { "designer": { "x": 1200, "y": 0 } }
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    },
    "designer": { "orphans": [] }
  }
}
