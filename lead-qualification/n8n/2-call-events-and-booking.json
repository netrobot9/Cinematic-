      "parameters": {
        "jsCode": "// Formats the result Vapi reads back to the assistant so it can confirm the booking aloud.\nconst req = $('Extract Tool Call').first().json;\nconst result = `Booked. The discovery call is confirmed for ${req.startTime} (${req.timezone}).`;\nreturn [{ json: { results: [{ toolCallId: req.toolCallId, result }] } }];"
      },
