    {
      "parameters": {
        "jsCode": "// Reads the Vapi tool-call payload and prepares a 30-minute calendar slot.\nconst body = $input.first().json.body ?? $input.first().json;\nconst msg = body.message ?? {};\nconst call = (msg.toolCallList ?? msg.toolCalls ?? [])[0];\nif (!call) throw new Error('No tool call found in payload');\n\nconst raw = call.function?.arguments ?? {};\nconst args = typeof raw === 'string' ? JSON.parse(raw) : raw;\n\nconst start = new Date(args.start_time);\nif (Number.isNaN(start.getTime())) throw new Error(`Invalid start_time: ${args.start_time}`);\nconst end = new Date(start.getTime() + 30 * 60 * 1000);\n\nreturn [{\n  json: {\n    toolCallId: call.id,\n    callId: msg.call?.id ?? null,\n    startTime: start.toISOString(),\n    endTime: end.toISOString(),\n    timezone: args.timezone ?? 'UTC',\n    name: args.name ?? '',\n  },\n}];"
      },
      "id": "b1b2c3d4-0012-4000-8000-000000000012",
      "name": "Extract Tool Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 760]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "primary"
        },
        "start": "={{ $json.startTime }}",
        "end": "={{ $json.endTime }}",
        "additionalFields": {
          "summary": "={{ 'Discovery call - ' + ($json.name || 'Lead') }}",
          "description": "Booked automatically by the AI lead qualification agent."
        }
      },
      "id": "b1b2c3d4-0013-4000-8000-000000000013",
