    {
      "parameters": {
        "jsCode": "// Text Parser (Match Pattern): turns the raw Vapi end-of-call report into a clean outcome record.\nconst body = $input.first().json.body ?? $input.first().json;\nconst msg = body.message ?? {};\nconst sd = msg.analysis?.structuredData ?? {};\nconst summary = (msg.analysis?.summary ?? msg.summary ?? '').trim();\nconst transcript = msg.transcript ?? '';\nconst haystack = `${summary}\\n${transcript}`;\n\nconst EMAIL = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/;\nconst STATUS = {\n  interested: 'Interested',\n  not_interested: 'Not Interested',\n  callback: 'Callback',\n  no_answer: 'No Answer',\n};\n\nconst outcome = STATUS[sd.outcome] ? sd.outcome : 'no_answer';\nconst emailMatch = haystack.match(EMAIL);\nconst appointmentTime = sd.appointment_time || null;\n\nconst emailBody = [\n  'Hi there,',\n  '',\n  'Thanks for speaking with us today.',\n  '',\n  appointmentTime\n    ? `Your discovery call is confirmed for ${appointmentTime}.`\n    : 'Reply to this email and we will find a time that works for you.',\n  '',\n  'Speak soon.',\n].join('\\n');\n\nreturn [{\n  json: {\n    callId: msg.call?.id ?? null,\n    outcome,\n    status: STATUS[outcome],\n    summary,\n    appointmentTime,\n    extractedEmail: emailMatch ? emailMatch[0] : null,\n    endedReason: msg.endedReason ?? null,\n    emailBody,\n  },\n}];"
      },
      "id": "b1b2c3d4-0003-4000-8000-000000000003",
      "name": "Text Parser (Match Pattern)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
